# local 프로파일은 application.yaml 의 기본값(localhost)을 쓰므로 이 파일 없이도 DB/Redis 연결은 된다.
# 단, Phase 2 (카카오 OAuth2 + JWT) 부터는 아래 KAKAO_*, JWT_SECRET 이 있어야 앱이 기동한다.
# 이 파일을 backend/.env 로 복사해서 값을 채운다. (.env 는 gitignore)
#
# application.yaml 의 `spring.config.import: optional:file:.env[.properties]` 가 이 파일을 읽는다.

# ── DB / Redis / 포트 ────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5433/bandive
DB_USERNAME=bandive
DB_PASSWORD=bandive

REDIS_HOST=localhost
REDIS_PORT=6380

SERVER_PORT=8081

# ── Phase 2 — 카카오 OAuth2 + JWT ───────────────────────────
# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_CLIENT_ID=
# 카카오 디벨로퍼스 > 보안 > Client Secret (생성 후 "사용함" 상태로)
KAKAO_CLIENT_SECRET=
# JWT 서명 키 (HS256, 최소 32바이트). 예: openssl rand -base64 48
JWT_SECRET=

# 로그인 성공/실패 후 프론트 복귀 URL — 기본값이 있으므로 보통 생략
# APP_OAUTH2_SUCCESS_REDIRECT=http://localhost:5173/oauth/success
# APP_OAUTH2_FAILURE_REDIRECT=http://localhost:5173/oauth/failure
# CORS 허용 오리진 (프론트) — 콤마로 여러 개. 기본값 http://localhost:5173
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://bandive.example.com

# 파일 업로드 (Phase 4 로고/배너 — 로컬 디스크. Phase 5 에서 S3 로 교체)
# APP_STORAGE_LOCAL_DIR=./uploads
# APP_STORAGE_PUBLIC_BASE_URL=http://localhost:8081

# 프론트 base URL — 초대 링크(inviteUrl = base + /invite/{code}) 생성용
# APP_FRONTEND_BASE_URL=http://localhost:5173
