# 운영(EC2) 서버용 환경변수. /opt/bandive/.env 로 서버에 "한 번만" 직접 올려둔다.
# (git 에는 절대 커밋하지 않음 — 이 파일은 예시일 뿐. .env 는 .gitignore 처리됨)
# docker-compose.prod.yml 이 이 값들을 읽는다.

# ── 도메인 / ECR ─────────────────────────────────────────────
# 실제 서비스 도메인 (Caddy 가 이 값으로 Let's Encrypt 인증서를 자동 발급)
DOMAIN=bandive.example.com
# ECR 레지스트리 URI. 예: 123456789012.dkr.ecr.ap-northeast-2.amazonaws.com
ECR_REGISTRY=

# ── DB ───────────────────────────────────────────────────────
DB_USERNAME=bandive
# openssl rand -base64 24 등으로 생성
DB_PASSWORD=

# ── 인증 ──────────────────────────────────────────────────────
# 카카오 디벨로퍼스에 https://${DOMAIN}/login/oauth2/code/kakao 를 Redirect URI 로 추가해야 함
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# openssl rand -base64 48
JWT_SECRET=

# ── 음원 검색 (선택 — 기본값 이미 itunes/US/KR) ────────────────
# MUSIC_PROVIDER=itunes
# MUSIC_COUNTRY=US
# MUSIC_LOCALIZE_COUNTRY=KR
