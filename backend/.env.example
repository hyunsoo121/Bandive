# local 프로파일은 application.yaml 의 기본값(localhost)을 쓰므로 이 파일 없이도 동작한다.
# prod 프로파일에서는 아래 값이 모두 필수.

DB_URL=jdbc:postgresql://localhost:5433/bandive
DB_USERNAME=bandive
DB_PASSWORD=bandive

REDIS_HOST=localhost
REDIS_PORT=6380

SERVER_PORT=8081

